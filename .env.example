# Postgres connection string (Neon or any Postgres).
# On Vercel the Neon integration (Storage -> Create Database) injects this
# automatically. Tables are created by the app on first signup.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: secret for signing session JWTs (openssl rand -base64 32).
# When unset, a key is derived from DATABASE_URL instead.
AUTH_SECRET=
